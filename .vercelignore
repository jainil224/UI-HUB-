# Vercel source-upload exclusions.
# The buildCommand reinstalls dependencies and regenerates dist/ on Vercel, so
# none of these belong in the uploaded source. Including them was consuming the
# deployment storage quota (~271 MB root node_modules + ~128 MB mcp-server
# node_modules + ~223 MB frontend/dist).

# Git / VCS
.git

# Dependencies (reinstalled by buildCommand)
node_modules
**/node_modules

# Build outputs (regenerated by buildCommand)
frontend/dist
dist-ssr
build

# Local editor / agent tooling (never needed at build or runtime)
.vscode
.idea
.agents
.opencode
.claude
.uihub-agent
component-specs
.originkit

# Docs / markdown
*.md

# Local temp, logs and unused config
tmp/
backend/tmp/
files.txt
*.py
backend/error.log
backend/scripts/
.firebaserc
firebase.json
functions/

# Unreferenced / duplicated static assets.
# Verified zero source references repo-wide. Kept in GitHub + locally, excluded
# only from the Vercel upload/build output (~131 MB of the deployment quota).
# CloudScroll loads the canonical /models/*.glb, never these copies.
**/*-old.glb
frontend/public/assets/cloud-scroll/models/**
**/mohitvirli.github.io-master/**
frontend/public/assets/section-scroll/section-scroll.zip
