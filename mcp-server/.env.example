# UI HUB MCP Server Environment Variables
# Copy this file to .env and fill in your values

# Server
MCP_PORT=3001
NODE_ENV=production

# MCP Configuration
MCP_SERVER_URL=https://api.ui-hub-design.com
MCP_API_KEY_PREFIX=uh_live_

# Rate Limits (requests per day per key)
MCP_RATE_LIMIT_FREE=100
MCP_RATE_LIMIT_PRO=10000

# Firebase (Admin SDK)
# Use a service account JSON key file
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# MongoDB
MONGODB_URI=mongodb+srv://uihub_backend:<db_password>@cluster0.rynecsh.mongodb.net/?appName=Cluster0
MONGODB_DB=uihub

# Redis (optional, for distributed rate limiting)
REDIS_URL=

# CORS Allowed Origins (comma-separated)
MCP_ALLOWED_ORIGINS=https://ui-hub-design.vercel.app,http://localhost:5173,http://localhost:3000

# Firebase project (client-side config, used to look up users)
# These mirror the frontend values
VITE_FIREBASE_PROJECT_ID=

# Admin override emails (comma-separated, get full access)
MCP_ADMIN_EMAILS=jainil11199@gmail.com,jainil224@gmail.com,jainilpatel2224@gmail.com
