# Brevo HTTP API Configuration (Transactional Emails)
BREVO_API_KEY="your_brevo_api_key_here"
BREVO_SENDER_EMAIL="hello@yourdomain.com"
BREVO_SENDER_NAME="UI-HUB"

# Brevo SMTP Configuration (Fallback / Legacy)
# IMPORTANT: BREVO_SMTP_USER must be your BREVO-VERIFIED sender email address
# (Check: Brevo Dashboard > Senders & IP > Senders)
# This is also used as the 'from' address in all emails!
BREVO_SMTP_USER="a6dced001@smtp-brevo.com"
BREVO_SMTP_PASS="your_brevo_smtp_key_here"
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER="a6dced001@smtp-brevo.com"
SMTP_PASS="your_brevo_smtp_key_here"
# Optional: Override the display 'from' address (defaults to BREVO_SMTP_USER if not set)
SMTP_FROM="a6dced001@smtp-brevo.com"

# Razorpay Configuration
RAZORPAY_KEY_ID="rzp_test_yourkeyid"
RAZORPAY_KEY_SECRET="your_razorpay_secret"

# MongoDB
MONGODB_URI="mongodb+srv://uihub_backend:<db_password>@cluster0.rynecsh.mongodb.net/?appName=Cluster0"
MONGODB_DB="uihub"
