
# Firebase Configuration
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_FIREBASE_AUTH_DOMAIN"
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_FIREBASE_STORAGE_BUCKET"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
VITE_FIREBASE_MEASUREMENT_ID="YOUR_FIREBASE_MEASUREMENT_ID"

# Brevo SMTP Configuration (Welcome Emails / Receipts)
# IMPORTANT: BREVO_SMTP_USER must be your BREVO-VERIFIED sender email address
# (Check: Brevo Dashboard > Senders & IP > Senders)
# This is also used as the 'from' address in all emails!
BREVO_SMTP_USER="your_brevo_verified_sender@yourdomain.com"
BREVO_SMTP_PASS="your_brevo_smtp_key_here"
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER="your_brevo_verified_sender@yourdomain.com"
SMTP_PASS="your_brevo_smtp_key_here"
# Optional: Override the display 'from' address (defaults to BREVO_SMTP_USER if not set)
SMTP_FROM="your_brevo_verified_sender@yourdomain.com"

# Razorpay Configuration
RAZORPAY_KEY_ID="rzp_test_yourkeyid"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
